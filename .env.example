# Required for live subscribe (Resend — https://resend.com)
RESEND_API_KEY=re_xxxxxxxx
SUBSCRIBE_NOTIFY_TO=you@example.com

# Optional — defaults to Resend onboarding sender (only delivers to your Resend account email)
SUBSCRIBE_FROM_EMAIL=updates@yourdomain.com

# Optional — store contacts in a Resend Audience (dashboard → Audiences)
RESEND_AUDIENCE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
